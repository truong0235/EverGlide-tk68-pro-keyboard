#!/usr/bin/env bash
set -uo pipefail

NAME="Tk68 Pro"
DEADLINE=$((SECONDS + 300))
BT_COMMAND_TIMEOUT=5

log() {
  if command -v systemd-cat >/dev/null 2>&1; then
    printf '%s\n' "$*" | systemd-cat -t tk68-pro-repair
  else
    printf '%s\n' "$*" >&2
  fi
}

bt() {
  #timeout "$BT_COMMAND_TIMEOUT" bluetoothctl "$@"
  bluetoothctl "$@"
}

get_tk68_devices() {
  bt devices | while read -r _ addr rest; do
    [ -n "${addr:-}" ] || continue

    if [ "${rest:-}" = "$NAME" ]; then
      printf '%s\n' "$addr"
      continue
    fi

    info="$(bt info "$addr" 2>/dev/null || true)"
    if printf '%s\n' "$info" | grep -Eq "^(Name|Alias): ${NAME}$"; then
      printf '%s\n' "$addr"
    fi
  done
}

remove_tk68_devices() {
  local removed=0

  while read -r addr; do
    [ -n "${addr:-}" ] || continue
    log "Removing saved ${NAME}: ${addr}"
    bt disconnect "$addr" >/dev/null 2>&1 || true
    bt remove "$addr" >/dev/null 2>&1 || true
    removed=1
  done < <(get_tk68_devices)

  [ "$removed" -eq 1 ] || log "No saved ${NAME} devices found"
}

is_connected() {
  bt info "$1" 2>/dev/null | grep -q "Connected: yes"
}

has_battery() {
  bt info "$1" 2>/dev/null | grep -q "Battery Percentage:"
}

is_good() {
  is_connected "$1" && has_battery "$1"
}

init_check() {
  local addr found=0

  while read -r addr; do
    [ -n "${addr:-}" ] || continue
    found=1
    log "Initial check ${NAME}: ${addr}"

    if is_good "$addr"; then
      log "${NAME} already connected with battery status: ${addr}"
      return 0
    fi
  done < <(get_tk68_devices)

  [ "$found" -eq 1 ] || log "Initial check found no saved ${NAME} devices"
  return 1
}

scan_until_tk68() {
  local remaining scan_timeout line addr scan_pid

  remaining=$((DEADLINE - SECONDS))
  [ "$remaining" -gt 0 ] || return 1

  scan_timeout="$remaining"

  bt power on >/dev/null 2>&1 || true
  bt pairable on >/dev/null 2>&1 || true

  log "Scanning for ${NAME} up to ${scan_timeout}s"
  coproc BTSCAN { bluetoothctl --timeout "$scan_timeout" scan on 2>&1; }
  scan_pid="$BTSCAN_PID"

  while IFS= read -r line <&"${BTSCAN[0]}"; do
    log "scan: ${line}"

    addr="$(printf '%s\n' "$line" | awk -v name="$NAME" '$0 ~ name {for (i = 1; i <= NF; i++) if ($i ~ /^([0-9A-F]{2}:){5}[0-9A-F]{2}$/) {print $i; exit}}')"
    if [ -n "${addr:-}" ]; then
      log "Found ${NAME} during scan: ${addr}"
      bt scan off >/dev/null 2>&1 &
      printf '%s\n' "$addr"
      return 0
    fi
  done

  bt scan off >/dev/null 2>&1 || true
  wait "$scan_pid" >/dev/null 2>&1 || true

  log "${NAME} not found during scan round"
  return 1
}

pair_trust_connect() {
  local addr="$1" output
  output="$(mktemp)"

  log "Pairing ${NAME}: ${addr}"
#  bluetoothctl >"$output" 2>&1 <<EOF || true
#agent KeyboardOnly
#default-agent
#pair $addr
#trust $addr
#connect $addr
#quit
#EOF

  bluetoothctl >"$output" 2>&1 <<EOF || true
agent KeyboardOnly
default-agent
pair $addr
quit
EOF
  while IFS= read -r line; do
    log "pair: ${line}"
  done <"$output"
  rm -f "$output"

  sleep 6

  if is_good "$addr"; then
    log "${NAME} paired and connected with battery status: ${addr}"
    return 0
  fi

  log "${NAME} pair/connect failed health check; removing and retrying: ${addr}"
  remove_tk68_devices
  return 1
}

repair_loop() {
  local addr

  while [ "$SECONDS" -lt "$DEADLINE" ]; do
    remove_tk68_devices

    addr="$(scan_until_tk68 || true)"
    if [ -z "${addr:-}" ]; then
      sleep 5
      continue
    fi

    if pair_trust_connect "$addr"; then
      return 0
    fi

    sleep 5
  done

  log "Repair timed out after 5 minutes; exiting"
  return 0
}

main() {
  log "Starting ${NAME} auto re-pair, max 5 minutes"
  bt power on >/dev/null 2>&1 || true
  bt agent KeyboardOnly >/dev/null 2>&1 || true
  bt default-agent >/dev/null 2>&1 || true

  if init_check; then
    exit 0
  fi

  repair_loop
  exit 0
}

main "$@"
